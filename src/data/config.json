    },
    {
      "key": "pressure",
      "label": "Atmospheric pressure",
      "unit": "kPa",
      "description": "Mean surface atmospheric pressure."
    },
    {
      "key": "daylight",
      "label": "Daylight",
      "unit": "h/day",
      "description": "Hours of daylight on the longest day of the year."
    },
    {
      "key": "precipitation",
      "label": "Precipitation",
      "unit": "mm/yr",
      "description": "Mean annual precipitation (rain plus snow water equivalent)."
    },
    {
      "key": "humidity",
      "label": "Relative humidity",
      "unit": "%",
      "description": "Mean annual relative humidity."
    },
    {
      "key": "dust",
      "label": "Dust activity",
      "unit": "index",
      "description": "0 to 100. Aeolian dust and aerosol loading proxy."
    },
    {
      "key": "isolation",
      "label": "Isolation",
      "unit": "index",
      "description": "0 to 100. Remoteness from people and infrastructure."
    },
    {
      "key": "elevation",
      "label": "Elevation",
      "unit": "m",
      "description": "Elevation above sea level."
    },
    {
      "key": "aqueous",
      "label": "Aqueous geochemistry",
      "unit": "index",
      "description": "0 to 100. How closely the water and rock chemistry matches past or present aqueous environments."
    }
  ],
